# Backend environment variables
# Copy this file to .env and fill in your values

# ---------------------------------------------------------------------------
# LLM Provider (choose ONE option below)
# ---------------------------------------------------------------------------

# ✅ RECOMMENDED: Groq API — FREE, very fast, no GPU needed, perfect for 8GB laptops.
# Get your free API key at: https://console.groq.com
# Supports Llama 3, Mixtral, and more — behaves exactly like ChatOpenAI from the course.
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# Alternative: HuggingFace Inference API — also FREE via API token.
# Get your token at: https://huggingface.co/settings/tokens
# LLM_PROVIDER=huggingface
# HUGGINGFACEHUB_API_TOKEN=hf_your_token_here
# HF_MODEL=mistralai/Mistral-7B-Instruct-v0.1

# Alternative: OpenAI API (paid, requires a billing account)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your_openai_key_here

# ---------------------------------------------------------------------------
# Embedding Model (runs locally on CPU — no API key needed)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Vector Store — ChromaDB persists the document embeddings to disk
# ---------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./chroma_db

# ---------------------------------------------------------------------------
# Data directory — put your medical PDFs or .txt files here
# ---------------------------------------------------------------------------
DATA_DIR=./src/data
