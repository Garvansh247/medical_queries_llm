# Backend environment variables
# Copy this file to .env and fill in your values

# --- LLM Provider ---
# Option 1: Ollama (local, free) - recommended for 16GB+ RAM laptops
# Leave LLM_PROVIDER=ollama and set the model name below.
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3

# Option 2: OpenAI API (cloud, requires paid API key)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Option 3: Groq API (cloud, free tier available, very fast)
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama3-8b-8192

# --- Embedding Model ---
# The sentence-transformers model to use for document embeddings (runs locally, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector Store ---
# Path where ChromaDB will persist the vector database on disk
CHROMA_PERSIST_DIR=./chroma_db

# --- Data ---
# Path to the directory containing medical guidelines/documents
DATA_DIR=./src/data
